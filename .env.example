# true = usa la testnet de Binance (recomendado hasta validar la estrategia)
BINANCE_TESTNET=true

# === Mercado ===
SYMBOL=BTCUSDT
INTERVAL=1h

# === Gestion de riesgo ===
QUOTE_PER_TRADE=100      # USDT a gastar por operacion
MAX_OPEN_POSITIONS=1
STOP_LOSS_PCT=0.02       # 2%
TAKE_PROFIT_PCT=0.04     # 4%
MAX_DAILY_LOSS=50        # USDT; si la perdida del dia supera esto, el bot deja de operar

# === Estrategia ===
# Opciones: sma_cross_rsi | rsi_reversion  (ver src/strategy.py)
STRATEGY=sma_cross_rsi

# Parametros de sma_cross_rsi
FAST_MA=20
SLOW_MA=50
RSI_PERIOD=14
RSI_MIN=45
RSI_MAX=70

# Parametros de rsi_reversion
RSI_BUY=30
RSI_EXIT=55

# === Telegram (opcional; deja vacio para desactivar) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Loop ===
POLL_SECONDS=60
DRY_RUN=true             # true = NO envia ordenes reales, solo loguea lo que haria
